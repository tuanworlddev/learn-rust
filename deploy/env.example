# Sao chép thành deploy/.env. Điền tên miền thật, không có https:// hoặc đường dẫn.
DOMAIN=

# URL gốc HTTPS, cùng tên miền với DOMAIN; không thêm đường dẫn.
SITE_URL=

# Giữ false khi nghiệm thu. Chỉ đặt true trên tên miền công khai chính thức.
SITE_INDEXABLE=false

# Thay bằng tag của bản phát hành trước khi build; giữ lại tag cũ để rollback.
APP_VERSION=local

# Tùy chọn: để trống cả nhóm nếu chưa dùng đồng bộ tài khoản.
# Lấy Project URL và publishable key từ Supabase Dashboard.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Chỉ dùng khi dự án còn dùng legacy anon key; ưu tiên publishable key ở trên.
# Không dùng secret key hoặc service_role key.
SUPABASE_ANON_KEY=
